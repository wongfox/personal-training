# ── Database ────────────────────────────────────────────────────────────────
# Neon: use the POOLED connection string for the app and the DIRECT one for
# migrations. Leave both unset in local development to use the embedded PGlite
# database in ./.data/pglite (real Postgres, no install needed).
DATABASE_URL=
DATABASE_URL_UNPOOLED=
DATABASE_POOL_MAX=5

# ── App ─────────────────────────────────────────────────────────────────────
APP_URL=http://localhost:3000
# Comma-separated emails that become SUPER_ADMIN when they register.
SUPER_ADMIN_EMAILS=

# ── Google sign-in (optional; the button is hidden until both are set) ──────
# Authorised redirect URI: ${APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Email (optional; without it, emails are printed to the server log) ──────
RESEND_API_KEY=
EMAIL_FROM="Personal Growth OS <no-reply@yourdomain.com>"

# ── AI coach (optional; without it the deterministic playbook coach is used) ─
ANTHROPIC_API_KEY=
# AI_MODEL=claude-opus-5-5

# ── Scheduled reminders ─────────────────────────────────────────────────────
# The scheduler calls GET /api/cron/notifications with "Authorization: Bearer $CRON_SECRET".
CRON_SECRET=
